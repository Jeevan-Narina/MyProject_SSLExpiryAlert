<mxfile host="app.diagrams.net" modified="2026-10-02T13:57:00.000Z" agent="Mozilla/5.0" version="21.0.0" type="device">
  <diagram id="dataflow-diagram" name="Data Flow Architecture">
    <mxGraphModel dx="1200" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1250" pageHeight="850" background="#ffffff" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <!-- Title Banner -->
        <mxCell id="df_title" value="&lt;b&gt;END-TO-END AUDIT &amp;amp; ESCALATION DATA FLOW PIPELINE&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#495057&quot;&gt;Asynchronous Multi-Tier Execution Lifecycle | Problem Statement #47 | PES University CSE&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#000000;strokeWidth=1.5;fontColor=#000000;fontSize=14;" vertex="1" parent="1">
          <mxGeometry x="40" y="20" width="1170" height="50" as="geometry" />
        </mxCell>

        <!-- STAGE 1: Ingestion & Trigger -->
        <mxCell id="stage1_box" value="&lt;b&gt;STAGE 1: Audit Ingestion&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;verticalAlign=top;align=center;spacingTop=10;fillColor=#ffffff;strokeColor=#000000;strokeWidth=1.5;fontColor=#000000;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="40" y="90" width="260" height="250" as="geometry" />
        </mxCell>

        <mxCell id="s1_cron" value="&lt;b&gt;Cron Schedule (02:00 UTC)&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#495057&quot; style=&quot;font-size:10px;&quot;&gt;Daily automated trigger for active domain assets&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#000000;strokeWidth=1;fontColor=#000000;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="60" y="130" width="220" height="50" as="geometry" />
        </mxCell>

        <mxCell id="s1_manual" value="&lt;b&gt;On-Demand API Trigger&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#495057&quot; style=&quot;font-size:10px;&quot;&gt;SysAdmin manual scan via UI / CLI&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#000000;strokeWidth=1;fontColor=#000000;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="60" y="195" width="220" height="50" as="geometry" />
        </mxCell>

        <mxCell id="s1_batch" value="&lt;b&gt;Partition &amp;amp; Batch Dispatch&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#495057&quot; style=&quot;font-size:10px;&quot;&gt;Splits 1,000+ endpoints into chunks&lt;br&gt;&lt;/font&gt;&lt;font color=&quot;#000000&quot; style=&quot;font-size:9px;&quot;&gt;Enqueues into Redis Broker&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#000000;strokeWidth=1.2;fontColor=#000000;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="60" y="260" width="220" height="60" as="geometry" />
        </mxCell>

        <!-- STAGE 2: Distributed Audit Engine -->
        <mxCell id="stage2_box" value="&lt;b&gt;STAGE 2: Distributed Audit Engine&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;verticalAlign=top;align=center;spacingTop=10;fillColor=#ffffff;strokeColor=#000000;strokeWidth=1.5;fontColor=#000000;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="340" y="90" width="270" height="250" as="geometry" />
        </mxCell>

        <mxCell id="s2_tls" value="&lt;b&gt;TLS Handshake Worker&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#333333&quot; style=&quot;font-size:10px;&quot;&gt;Non-blocking socket to port 443&lt;br&gt;&lt;/font&gt;&lt;font color=&quot;#495057&quot; style=&quot;font-size:9px;&quot;&gt;Extracts X.509 NotAfter &amp;amp; CA chain&lt;br&gt;Validates SAN &amp;amp; cipher suites&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#000000;strokeWidth=1.2;fontColor=#000000;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="355" y="130" width="240" height="85" as="geometry" />
        </mxCell>

        <mxCell id="s2_whois" value="&lt;b&gt;WHOIS / RDAP Resolver&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#333333&quot; style=&quot;font-size:10px;&quot;&gt;Queries ICANN RDAP / port 43&lt;br&gt;&lt;/font&gt;&lt;font color=&quot;#495057&quot; style=&quot;font-size:9px;&quot;&gt;Parses domain registrar expiry&lt;br&gt;Token-bucket rate limiting with jitter&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#000000;strokeWidth=1.2;fontColor=#000000;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="355" y="230" width="240" height="90" as="geometry" />
        </mxCell>

        <!-- STAGE 3: Expiry Evaluation -->
        <mxCell id="stage3_box" value="&lt;b&gt;STAGE 3: Expiry Evaluation&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;verticalAlign=top;align=center;spacingTop=10;fillColor=#ffffff;strokeColor=#000000;strokeWidth=1.5;fontColor=#000000;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="650" y="90" width="260" height="250" as="geometry" />
        </mxCell>

        <mxCell id="s3_delta" value="&lt;b&gt;Delta Days Calculation&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#333333&quot; style=&quot;font-size:10px;&quot;&gt;Days_Left = Expiry - Now(UTC)&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#000000;strokeWidth=1;fontColor=#000000;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="665" y="130" width="230" height="50" as="geometry" />
        </mxCell>

        <mxCell id="s3_policy" value="&lt;b&gt;Escalation Policy Evaluation&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#333333&quot; style=&quot;font-size:9px;&quot;&gt;• Tier 1: ≤ 30 Days (Warning)&lt;br&gt;• Tier 2: ≤ 14 Days (Urgent)&lt;br&gt;&lt;b&gt;• Tier 3: ≤ 3 Days (Critical P1)&lt;/b&gt;&lt;br&gt;&lt;/font&gt;&lt;font color=&quot;#495057&quot; style=&quot;font-size:9px;&quot;&gt;Checks Unack Duration (&gt;48h)&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#000000;strokeWidth=1.2;fontColor=#000000;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="665" y="195" width="230" height="125" as="geometry" />
        </mxCell>

        <!-- STAGE 4: Multi-Channel Dispatch -->
        <mxCell id="stage4_box" value="&lt;b&gt;STAGE 4: Multi-Channel Dispatch&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;verticalAlign=top;align=center;spacingTop=10;fillColor=#ffffff;strokeColor=#000000;strokeWidth=1.5;fontColor=#000000;fontSize=12;" vertex="1" parent="1">

        <mxCell id="st_t1" value="&lt;b&gt;TIER 1 WARNING&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#495057&quot; style=&quot;font-size:9px;&quot;&gt;≤ 30d (SysAdmin)&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#000000;strokeWidth=1.2;fontColor=#000000;fontSize=10;" vertex="1" parent="1">

        </mxCell>

        <mxCell id="st_t2" value="&lt;b&gt;TIER 2 URGENT&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#495057&quot; style=&quot;font-size:9px;&quot;&gt;≤ 14d / Unack 48h&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#000000;strokeWidth=1.2;fontColor=#000000;fontSize=10;" vertex="1" parent="1">
          <mxGeometry x="390" y="440" width="130" height="50" as="geometry" />
        </mxCell>

        <mxCell id="st_t3" value="&lt;b&gt;TIER 3 CRITICAL&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#495057&quot; style=&quot;font-size:9px;&quot;&gt;≤ 3d (Security Off.)&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#000000;strokeWidth=1.5;fontColor=#000000;fontSize=10;" vertex="1" parent="1">
          <mxGeometry x="570" y="440" width="140" height="50" as="geometry" />
        </mxCell>

        <mxCell id="st_ack" value="&lt;b&gt;ACKNOWLEDGED STATE&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#495057&quot; style=&quot;font-size:9px;&quot;&gt;SysAdmin mutes reminders during active certificate renewal&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#000000;strokeWidth=1.2;fontColor=#000000;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="220" y="530" width="220" height="60" as="geometry" />
        </mxCell>

        <mxCell id="st_resolved" value="&lt;b&gt;RESOLVED &amp;amp; CLOSED&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#495057&quot; style=&quot;font-size:9px;&quot;&gt;New valid certificate detected on subsequent daily audit&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#000000;strokeWidth=1.2;fontColor=#000000;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="490" y="530" width="220" height="60" as="geometry" />
        </mxCell>


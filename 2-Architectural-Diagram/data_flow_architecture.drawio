          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- LOWER SECTION: INCIDENT LIFECYCLE STATE MACHINE -->
        <mxCell id="lifecycle_box" value="&lt;b&gt;Incident Lifecycle &amp;amp; Escalation Ladder Transitions&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;verticalAlign=top;align=center;spacingTop=10;fillColor=#ffffff;strokeColor=#000000;strokeWidth=1.5;fontColor=#000000;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="40" y="380" width="690" height="230" as="geometry" />
        </mxCell>

        <mxCell id="st_healthy" value="&lt;b&gt;HEALTHY&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#495057&quot; style=&quot;font-size:9px;&quot;&gt;&gt; 30 Days Left&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#000000;strokeWidth=1.2;fontColor=#000000;fontSize=11;" vertex="1" parent="1">

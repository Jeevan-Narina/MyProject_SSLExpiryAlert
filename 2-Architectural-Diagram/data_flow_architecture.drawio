        </mxCell>

        <!-- LOWER RIGHT: STORAGE & AUDIT LEDGER -->
        <mxCell id="audit_box" value="&lt;b&gt;Audit Ledger &amp;amp; Security Validation&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;verticalAlign=top;align=center;spacingTop=10;fillColor=#ffffff;strokeColor=#000000;strokeWidth=1.5;fontColor=#000000;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="760" y="380" width="450" height="230" as="geometry" />
        </mxCell>

        <mxCell id="ad_pg" value="&lt;b&gt;PostgreSQL Audit Trail Log&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#495057&quot; style=&quot;font-size:10px;&quot;&gt;Records endpoint FQDN, scan latency, X.509 thumbprint, response codes&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#000000;strokeWidth=1;fontColor=#000000;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="780" y="430" width="410" height="50" as="geometry" />
        </mxCell>

        <mxCell id="ad_vault" value="&lt;b&gt;AES-256-GCM Envelope Encryption (NFR-002)&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#495057&quot; style=&quot;font-size:10px;&quot;&gt;Protects Slack Webhook URLs, PagerDuty tokens, SMTP auth at rest&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#000000;strokeWidth=1;fontColor=#000000;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="780" y="495" width="410" height="50" as="geometry" />
        </mxCell>

        <mxCell id="ad_compliance" value="&lt;b&gt;Compliance Reporting Engine&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#495057&quot; style=&quot;font-size:10px;&quot;&gt;Exports ISO 27001 &amp;amp; SOC 2 auditable certificates in CSV and PDF formats&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#000000;strokeWidth=1;fontColor=#000000;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="780" y="555" width="410" height="45" as="geometry" />
        </mxCell>

        <!-- BOTTOM BANNER: NFR COMPLIANCE -->
        <mxCell id="nfr_box" value="&lt;b&gt;NON-FUNCTIONAL REQUIREMENT (NFR) ARCHITECTURAL ENFORCEMENT&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#000000&quot;&gt;&lt;b&gt;NFR-001 (Performance):&lt;/b&gt; 1,000 domains audited in ≤ 180s via 4 worker processes × 50 concurrent sockets | RAM &lt; 2 GB, CPU &lt; 50%&lt;/font&gt;&lt;br&gt;&lt;font color=&quot;#000000&quot;&gt;&lt;b&gt;NFR-002 (Security &amp;amp; HA):&lt;/b&gt; AES-256-GCM encrypted secrets at rest | OAuth2 RBAC | 99.95% uptime via Redis Redlock failover&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#000000;strokeWidth=1.5;fontColor=#000000;fontSize=11;" vertex="1" parent="1">

          <mxGeometry x="965" y="195" width="230" height="50" as="geometry" />
        </mxCell>

        <mxCell id="s4_t3" value="&lt;b&gt;Tier 3: Security Officer P1&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#333333&quot; style=&quot;font-size:10px;&quot;&gt;PagerDuty High Urgency &amp;amp; SMS&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#000000;strokeWidth=1.2;fontColor=#000000;fontSize=10;" vertex="1" parent="1">
          <mxGeometry x="965" y="260" width="230" height="60" as="geometry" />
        </mxCell>

